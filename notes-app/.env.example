# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo server-side: lo usa el endpoint MCP. Nunca exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL pública de la app (Railway). Se usa para el redirect del magic link
# y para mostrar las instrucciones de conexión MCP.
NEXT_PUBLIC_SITE_URL=https://notes-production.up.railway.app

# Control de acceso al login por magic link (opcional pero recomendado).
# Lista de emails permitidos separados por coma, y/o dominios permitidos.
# Si ambos están vacíos, cualquier email puede entrar.
ALLOWED_EMAILS=leojuarez58@gmail.com
ALLOWED_EMAIL_DOMAINS=
